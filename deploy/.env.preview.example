# Copy to deploy/.env.preview on the preview host. Never commit the real file.

CONVOWEAVE_ENV=preview
PUBLIC_BASE_URL=https://preview-api.example.com
CONVOWEAVE_STORAGE_MODE=filesystem
CONVOWEAVE_DATA_DIR=/data/convoweave
CONVOWEAVE_AUDIO_RETENTION=delete-after-processing

# Preferred preview auth once an identity provider is configured.
CONVOWEAVE_AUTH_MODE=oidc
OIDC_ISSUER=https://login.example.com/
OIDC_AUDIENCE=convoweave-api
OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256

# Real preview AI provider. Supply at runtime only.
CONVOWEAVE_PROCESSING_PROVIDER=openai
OPENAI_API_KEY=replace-at-runtime-only
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000
OPENAI_BASE_URL=https://api.openai.com
