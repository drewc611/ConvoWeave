# Backend-only configuration. Never expose these values through EXPO_PUBLIC_* variables.

CONVOWEAVE_ENV=development
CONVOWEAVE_AUTH_MODE=development-token
CONVOWEAVE_DEV_TOKEN=replace-with-local-development-token
CONVOWEAVE_PROCESSING_PROVIDER=deterministic
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=

# Storage defaults:
# - development: memory
# - preview: filesystem
# Raw audio defaults to delete-after-processing.
CONVOWEAVE_STORAGE_MODE=memory
CONVOWEAVE_DATA_DIR=.convoweave/backend-data
CONVOWEAVE_AUDIO_RETENTION=delete-after-processing

# OIDC authentication example for preview/production.
# CONVOWEAVE_AUTH_MODE=oidc
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=convoweave-api
# OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_JWKS_TIMEOUT_MS=5000
# OIDC_JWKS_CACHE_MAX_AGE_MS=600000
# OIDC_JWKS_COOLDOWN_MS=30000
# OIDC_CLOCK_TOLERANCE_SECONDS=5

# Preview provider example. OPENAI_API_KEY is a backend secret and must never be committed.
# CONVOWEAVE_ENV=preview
# CONVOWEAVE_PROCESSING_PROVIDER=openai
# CONVOWEAVE_STORAGE_MODE=filesystem
# CONVOWEAVE_DATA_DIR=/data/convoweave
# CONVOWEAVE_AUDIO_RETENTION=delete-after-processing
# OPENAI_API_KEY=replace-at-runtime-only
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
# OPENAI_TIMEOUT_MS=60000
# OPENAI_BASE_URL=https://api.openai.com
