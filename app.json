{
  "expo": {
    "name": "ConvoWeave",
    "slug": "convoweave",
    "version": "0.3.0",
    "scheme": "convoweave",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.convoweave.mobile",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.convoweave.mobile",
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ConvoWeave to record meetings after you explicitly start a capture.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow ConvoWeave to show upcoming device calendar events only after you choose to connect your calendar."
        }
      ]
    ]
  }
}
